    lbl.TextSize = 11
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local preview = Instance.new("Frame")
    preview.Size = UDim2.new(0, 35, 0, 14)
    preview.Position = UDim2.new(1, -43, 0, 4)
    preview.BackgroundColor3 = defaultColor
    preview.Parent = frame
    Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 3)

    local spectrum = Instance.new("ImageButton")
    spectrum.Size = UDim2.new(1, -24, 0, 14)
    spectrum.Position = UDim2.new(0, 12, 0, 22)
    spectrum.Image = "rbxassetid://6983758117"
    spectrum.BorderSizePixel = 0
    spectrum.Parent = frame
    Instance.new("UICorner", spectrum).CornerRadius = UDim.new(0, 3)

    local specPin = Instance.new("Frame")
    specPin.Size = UDim2.new(0, 12, 0, 12)
    specPin.AnchorPoint = Vector2.new(0.5, 0.5)
    specPin.BackgroundColor3 = Color3.new(1, 1, 1)
    specPin.Parent = spectrum
    Instance.new("UICorner", specPin).CornerRadius = UDim.new(1, 0)
    local sStroke = Instance.new("UIStroke")
    sStroke.Thickness = 1.5
    sStroke.Color = Color3.new(0,0,0)
    sStroke.Parent = specPin

    local vSlider = Instance.new("Frame")
    vSlider.Size = UDim2.new(1, -24, 0, 12)
    vSlider.Position = UDim2.new(0, 12, 0, 44)
    vSlider.BorderSizePixel = 0
    vSlider.Parent = frame
    Instance.new("UICorner", vSlider).CornerRadius = UDim.new(0, 3)

    local vGrad = Instance.new("UIGradient")
    vGrad.Parent = vSlider

    local vButton = Instance.new("ImageButton")
    vButton.Size = UDim2.new(1, 0, 1, 0)
    vButton.BackgroundTransparency = 1
    vButton.Parent = vSlider

    local vPin = Instance.new("Frame")
    vPin.Size = UDim2.new(0, 12, 0, 12)
    vPin.AnchorPoint = Vector2.new(0.5, 0.5)
    vPin.BackgroundColor3 = Color3.new(1, 1, 1)
    vPin.Parent = vSlider
    Instance.new("UICorner", vPin).CornerRadius = UDim.new(1, 0)
    local vStroke = Instance.new("UIStroke")
    vStroke.Thickness = 1.5
    vStroke.Color = Color3.new(0,0,0)
    vStroke.Parent = vPin

    local currentH, currentS, currentV = defaultColor:ToHSV()
    specPin.Position = UDim2.new(currentH, 0, 0.5, 0)
    vPin.Position = UDim2.new(currentV, 0, 0.5, 0)

    local function updateSliderGrad()
        vGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(currentH, 1, 1))
        })
    end
    updateSliderGrad()

    local function updateColor()
        local resultColor = Color3.fromHSV(currentH, currentS, currentV)
        preview.BackgroundColor3 = resultColor
        callback(resultColor)
    end

    local function processSpec(input)
        local inputPos = input.Position
        local relativeX = math.clamp((inputPos.X - spectrum.AbsolutePosition.X) / spectrum.AbsoluteSize.X, 0, 1)
        currentH = relativeX
        specPin.Position = UDim2.new(relativeX, 0, 0.5, 0)
        updateSliderGrad()
        updateColor()
    end

    local function processV(input)
        local inputPos = input.Position
        local relativeX = math.clamp((inputPos.X - vSlider.AbsolutePosition.X) / vSlider.AbsoluteSize.X, 0, 1)
        currentV = relativeX
        vPin.Position = UDim2.new(relativeX, 0, 0.5, 0)
        updateColor()
    end

    local activeSpec = false
    spectrum.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSpec = true
            processSpec(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if activeSpec and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            processSpec(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSpec = false
        end
    end)

    local activeV = false
    vButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeV = true
            processV(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if activeV and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            processV(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeV = false
        end
    end)
end

